{
  "manifest_version": 3,
  "name": "smarty-observability",
  "version": "0.1.0",
  "description": "前端可观测 + 自愈，不开 F12：popup 看错误/AI 诊断，content script 后台捕获。",
  "action": { "default_popup": "popup.html", "default_title": "smarty-observability" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:3921/*", "http://127.0.0.1:3920/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
